{
  "name": "phone-pilot-pigeon",
  "services": {
    "pigeon": {
      "image": "firerpa/pigeon:1.0",
      "restart": "unless-stopped",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "20m",
          "max-file": "5"
        }
      },
      "mem_limit": "768m",
      "memswap_limit": "1408m",
      "depends_on": {
        "postgres": {
          "condition": "service_healthy"
        },
        "rabbitmq": {
          "condition": "service_healthy"
        },
        "redis-master": {
          "condition": "service_healthy"
        },
        "redis-slave01": {
          "condition": "service_healthy"
        },
        "redis-slave02": {
          "condition": "service_healthy"
        },
        "redis-lock01": {
          "condition": "service_healthy"
        },
        "redis-lock02": {
          "condition": "service_healthy"
        },
        "redis-lock03": {
          "condition": "service_healthy"
        }
      },
      "environment": {
        "DOMAIN": "${DOMAIN:?}",
        "API_PORT": "${API_PORT:?}",
        "WEB_PORT": "${WEB_PORT:?}",
        "FWD_PORT": "${FWD_PORT:?}",
        "MQP_PORT": "${MQP_PORT:?}",
        "REDIS_PASSWORD": "${REDIS_PASSWORD:?}",
        "RABBITMQ_PASSWORD": "${RABBITMQ_PASSWORD:?}",
        "POSTGRES_PASSWORD": "${POSTGRES_PASSWORD:?}",
        "LOCAL_LAN_IP": "${LOCAL_LAN_IP:?}",
        "PUBLIC_IP": "${PUBLIC_IP:?}"
      },
      "cap_add": [
        "NET_ADMIN",
        "SYS_ADMIN"
      ],
      "ports": [
        "127.0.0.1:${API_PORT}:${API_PORT}",
        "0.0.0.0:${WEB_PORT}:${WEB_PORT}",
        "0.0.0.0:${FWD_PORT}:${FWD_PORT}",
        "0.0.0.0:${MQP_PORT}:8883"
      ],
      "networks": [
        "pigeon-net"
      ],
      "volumes": [
        "./data/user:/user",
        "./single-phone-supervisord.conf:/etc/supervisord.conf:ro",
        "./single-phone-nginx.conf:/usr/local/openresty/nginx/conf/nginx.conf:ro",
        "./auth.single-phone.py:/usr/lib/python3/dist-packages/executor/auth.py:ro"
      ],
      "cpus": 1.5,
      "pids_limit": 128
    },
    "postgres": {
      "image": "postgres:18",
      "restart": "unless-stopped",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "20m",
          "max-file": "5"
        }
      },
      "mem_limit": "384m",
      "memswap_limit": "512m",
      "shm_size": "128m",
      "networks": [
        "pigeon-net"
      ],
      "environment": {
        "PGDATA": "/var/lib/postgresql/data",
        "POSTGRES_PASSWORD": "${POSTGRES_PASSWORD:?}",
        "POSTGRES_USER": "postgres",
        "POSTGRES_DB": "pigeon",
        "POSTGRES_INITDB_ARGS": "--auth-host=scram-sha-256 --auth-local=scram-sha-256"
      },
      "volumes": [
        "./postgres.conf:/etc/postgresql/postgresql.conf:ro",
        "./data/postgres:/var/lib/postgresql/data"
      ],
      "command": [
        "postgres",
        "-c",
        "config_file=/etc/postgresql/postgresql.conf"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "pg_isready",
          "-U",
          "postgres"
        ],
        "interval": "10s",
        "timeout": "5s",
        "retries": 12
      }
    },
    "rabbitmq": {
      "image": "rabbitmq:3",
      "restart": "unless-stopped",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "20m",
          "max-file": "5"
        }
      },
      "mem_limit": "256m",
      "memswap_limit": "384m",
      "networks": [
        "pigeon-net"
      ],
      "environment": {
        "RABBITMQ_DEFAULT_USER": "rabbit",
        "RABBITMQ_DEFAULT_PASS": "${RABBITMQ_PASSWORD:?}",
        "RABBITMQ_SERVER_ADDITIONAL_ERL_ARGS": "+S 2:2"
      },
      "volumes": [
        "./data/rabbitmq:/var/lib/rabbitmq",
        "./rabbitmq.conf:/etc/rabbitmq/rabbitmq.conf:ro"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "rabbitmq-diagnostics",
          "-q",
          "ping"
        ],
        "interval": "20s",
        "timeout": "10s",
        "retries": 10,
        "start_period": "30s"
      }
    },
    "redis-master": {
      "image": "redis:8",
      "restart": "unless-stopped",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "20m",
          "max-file": "5"
        }
      },
      "mem_limit": "96m",
      "memswap_limit": "128m",
      "environment": {
        "REDIS_PASSWORD": "${REDIS_PASSWORD:?}"
      },
      "networks": [
        "pigeon-net"
      ],
      "command": [
        "sh",
        "/usr/bin/redis-server.sh"
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "REDISCLI_AUTH=\"$REDIS_PASSWORD\" redis-cli ping | grep -q PONG"
        ],
        "interval": "15s",
        "timeout": "5s",
        "retries": 10
      },
      "volumes": [
        "./redis/server-master.sh:/usr/bin/redis-server.sh:ro",
        "./data/redis-master:/data"
      ]
    },
    "redis-slave01": {
      "image": "redis:8",
      "restart": "unless-stopped",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "20m",
          "max-file": "5"
        }
      },
      "mem_limit": "96m",
      "memswap_limit": "128m",
      "environment": {
        "REDIS_PASSWORD": "${REDIS_PASSWORD:?}"
      },
      "networks": [
        "pigeon-net"
      ],
      "command": [
        "sh",
        "/usr/bin/redis-server.sh"
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "REDISCLI_AUTH=\"$REDIS_PASSWORD\" redis-cli ping | grep -q PONG"
        ],
        "interval": "15s",
        "timeout": "5s",
        "retries": 10
      },
      "volumes": [
        "./redis/server-slave.sh:/usr/bin/redis-server.sh:ro",
        "./data/redis-slave01:/data"
      ]
    },
    "redis-slave02": {
      "image": "redis:8",
      "restart": "unless-stopped",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "20m",
          "max-file": "5"
        }
      },
      "mem_limit": "96m",
      "memswap_limit": "128m",
      "environment": {
        "REDIS_PASSWORD": "${REDIS_PASSWORD:?}"
      },
      "networks": [
        "pigeon-net"
      ],
      "command": [
        "sh",
        "/usr/bin/redis-server.sh"
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "REDISCLI_AUTH=\"$REDIS_PASSWORD\" redis-cli ping | grep -q PONG"
        ],
        "interval": "15s",
        "timeout": "5s",
        "retries": 10
      },
      "volumes": [
        "./redis/server-slave.sh:/usr/bin/redis-server.sh:ro",
        "./data/redis-slave02:/data"
      ]
    },
    "redis-lock01": {
      "image": "redis:8",
      "restart": "unless-stopped",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "20m",
          "max-file": "5"
        }
      },
      "mem_limit": "96m",
      "memswap_limit": "128m",
      "environment": {
        "REDIS_PASSWORD": "${REDIS_PASSWORD:?}"
      },
      "networks": [
        "pigeon-net"
      ],
      "command": [
        "sh",
        "/usr/bin/redis-server.sh"
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "REDISCLI_AUTH=\"$REDIS_PASSWORD\" redis-cli ping | grep -q PONG"
        ],
        "interval": "15s",
        "timeout": "5s",
        "retries": 10
      },
      "volumes": [
        "./redis/server-lock.sh:/usr/bin/redis-server.sh:ro",
        "./data/redis-lock01:/data"
      ]
    },
    "redis-lock02": {
      "image": "redis:8",
      "restart": "unless-stopped",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "20m",
          "max-file": "5"
        }
      },
      "mem_limit": "96m",
      "memswap_limit": "128m",
      "environment": {
        "REDIS_PASSWORD": "${REDIS_PASSWORD:?}"
      },
      "networks": [
        "pigeon-net"
      ],
      "command": [
        "sh",
        "/usr/bin/redis-server.sh"
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "REDISCLI_AUTH=\"$REDIS_PASSWORD\" redis-cli ping | grep -q PONG"
        ],
        "interval": "15s",
        "timeout": "5s",
        "retries": 10
      },
      "volumes": [
        "./redis/server-lock.sh:/usr/bin/redis-server.sh:ro",
        "./data/redis-lock02:/data"
      ]
    },
    "redis-lock03": {
      "image": "redis:8",
      "restart": "unless-stopped",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "20m",
          "max-file": "5"
        }
      },
      "mem_limit": "96m",
      "memswap_limit": "128m",
      "environment": {
        "REDIS_PASSWORD": "${REDIS_PASSWORD:?}"
      },
      "networks": [
        "pigeon-net"
      ],
      "command": [
        "sh",
        "/usr/bin/redis-server.sh"
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "REDISCLI_AUTH=\"$REDIS_PASSWORD\" redis-cli ping | grep -q PONG"
        ],
        "interval": "15s",
        "timeout": "5s",
        "retries": 10
      },
      "volumes": [
        "./redis/server-lock.sh:/usr/bin/redis-server.sh:ro",
        "./data/redis-lock03:/data"
      ]
    }
  },
  "networks": {
    "pigeon-net": {
      "driver": "bridge",
      "ipam": {
        "config": [
          {
            "subnet": "172.29.60.0/24"
          }
        ]
      }
    }
  }
}
